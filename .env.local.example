# Local environment configuration for DVC operations
# Copy this to .env.local and adjust if needed

# For running DVC commands on your HOST machine (outside Docker)
AWS_ENDPOINT_URL_S3=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
MLFLOW_TRACKING_URI=http://localhost:5000

# Note: Inside Docker containers, these are set differently:
# - AWS_ENDPOINT_URL_S3=http://minio:9000 (Docker internal network)
# This is automatically handled by docker-compose.full-stack.yml
