FROM apache/airflow:2.9.2

USER root

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends git curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copy and setup entrypoint script
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Create workspace directory
RUN mkdir -p /home/airflow/workspace && \
    chown -R airflow:root /home/airflow/workspace && \
    chmod -R 775 /home/airflow/workspace

USER airflow

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Verify DVC and MLflow installation
RUN dvc version && python -c "import mlflow; print(f'MLflow version: {mlflow.__version__}')"

# Set entrypoint
USER root
ENTRYPOINT ["/entrypoint.sh"]
CMD ["airflow"]
